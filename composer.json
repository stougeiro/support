{
    "name": "stougeiro/support",
    "description": "Lightweight PHP 8.2+ utilities for arrays, strings, dates, passwords, files, base64, and TTL — zero dependencies, PHPStan Level 9.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "utilities",
        "helpers",
        "array",
        "string",
        "date",
        "password",
        "filesystem",
        "base64",
        "ttl",
        "slugify",
        "mask",
        "fqcn",
        "transliterate",
        "zero-dependency",
        "toolkit"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/support/issues",
        "source": "https://github.com/stougeiro/support"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Support\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest"
    }
}
