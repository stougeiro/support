{
    "name": "stougeiro/support",
    "description": "A small helper library providing generic support utilities for PHP applications.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "support",
        "helpers",
        "utilities",
        "functions",
        "php-helpers",
        "php-utilities",
        "toolkit",
        "assist",
        "helper-functions",
        "support-library"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/support/issues",
        "source": "https://github.com/stougeiro/support"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Support\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest"
    }
}
