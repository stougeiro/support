    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "support",
        "helpers",
        "utilities",
        "functions",
        "php-helpers",
        "php-utilities",
        "toolkit",
        "assist",
        "helper-functions",
        "support-library"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/support/issues",
        "source": "https://github.com/stougeiro/support"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Support\\": "src/"
        }
    },
